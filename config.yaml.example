# 실험 설정 파일
experiment:
  name: "HWPX vs PDF Table Extraction RAG"
  version: "1.0.0"
  
# API 설정
api:
  openai:
    api_key: "YOUR_OPENAI_API_KEY_HERE"
    model: "gpt-4o-mini"  # gpt-4o, gpt-4o-mini, gpt-3.5-turbo 사용 가능
    temperature: 0.0
  gemini:
    api_key: "YOUR_GEMINI_API_KEY_HERE"
    model: "gemini-2.0-flash-exp"  # gemini-2.5-pro 또는 gemini-2.0-flash-exp 사용 가능
    temperature: 0.0

# 베이스라인 모델 설정
baselines:
  pdf:
    - name: "pdfplumber"
      enabled: true
    - name: "camelot"
      enabled: true
      flavor: "lattice"  # lattice or stream
    - name: "tabula"
      enabled: true

# RAG 설정
rag:
  embedding_model: "text-embedding-004"  # Gemini embedding
  vector_store: "chroma"
  chunk_size: 1000
  chunk_overlap: 200
  top_k: 5

# 평가 메트릭 목표
target_metrics:
  table_extraction:
    f1_score_improvement: 0.15  # 15% 향상
    speed_improvement: 0.30  # 30% 향상
  rag_performance:
    em_score_improvement: 0.10  # 10% 향상
    hit_at_1: 0.70
    hit_at_3: 0.85
    hit_at_5: 0.90

# 데이터셋 경로
dataset:
  hwpx_path: "./data/hwpx"
  pdf_path: "./data/pdf"
  ground_truth_path: "./data/ground_truth"
  questions_path: "./data/questions.json"

