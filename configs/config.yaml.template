# HierTable-RAG Configuration Template
# Copy this file to config.yaml and fill in your values

# API Keys
api_keys:
  openai: "your-openai-api-key-here"
  # Add other API keys as needed

# Model Configuration
models:
  embedding:
    name: "sentence-transformers/all-MiniLM-L6-v2"
    device: "cpu"  # "cpu" or "cuda"
    batch_size: 32
  
  llm:
    provider: "openai"  # "openai", "anthropic", etc.
    model_name: "gpt-3.5-turbo"
    temperature: 0.7
    max_tokens: 1000

# Paths
paths:
  data_dir: "data"
  raw_data_dir: "data/raw"
  processed_data_dir: "data/processed"
  output_dir: "outputs"
  vector_store_dir: "indices"
  experiments_dir: "experiments"

# Extraction Settings
extraction:
  pdf:
    use_pdfplumber: true
    extract_images: false
    extract_text: true
  
  table_detection:
    min_rows: 2
    min_cols: 2
    merge_cells: true

# Processing Settings
processing:
  hierarchy_detection:
    enabled: true
    similarity_threshold: 0.8
    use_graph_analysis: true
  
  normalization:
    remove_empty_rows: true
    remove_empty_cols: true
    normalize_whitespace: true

# Retrieval Settings
retrieval:
  vector_store:
    index_type: "faiss"  # "faiss", "annoy", etc.
    metric: "cosine"  # "cosine", "euclidean", "dot"
    dimension: 384  # Should match embedding model dimension
  
  search:
    default_top_k: 5
    rerank: false
    rerank_model: null

# Generation Settings
generation:
  prompt_template: "default"  # Path to custom template
  include_table_structure: true
  max_context_tables: 10
  format_response: true

# Logging
logging:
  level: "INFO"  # "DEBUG", "INFO", "WARNING", "ERROR"
  log_dir: "logs"
  log_file: "hiertable_rag.log"
  console_output: true

# Experiment Settings
experiments:
  default_seed: 42
  save_checkpoints: true
  checkpoint_interval: 100
  output_format: "json"  # "json", "csv", "both"

# Performance Settings
performance:
  num_workers: 4
  chunk_size: 1000
  use_gpu: false
  memory_limit_gb: 8


